{
  "version": 2,
  "name": "jobfor-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_MODE": "real",
    "VITE_API_BASE_URL": "https://jobfor-backend.onrender.com/api/v1"
  }
}